# Docker 部署配置（复制为 .env）
# 本仓库发布的 GitHub Container Registry 镜像地址；参见 README 的部署说明。
ARTEX_IMAGE=ghcr.io/yzbenyu-wq/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# HTTP User-Agent；留空时从浏览器 UA 样本中随机抽选，填写则使用固定值
ARTEX_HTTP_USER_AGENT=

# 异地加密备份（可选，启用 offsite profile 前填写）
# BACKUP_OFFSITE_HOST_DIR=/Volumes/<磁盘>/artex-backup
# BACKUP_RESTIC_PASSWORD=
